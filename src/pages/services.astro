---
import Layout from "../layouts/Layout.astro";

// Services data
const services = [
    {
        title: "Brand Identity",
        description:
            "We craft distinctive visual identities that resonate with your audience and stand the test of time.",
        includes: [
            "Logo design & brand guidelines",
            "Visual identity system",
            "Brand strategy & positioning",
            "Collateral design",
            "Brand voice & messaging",
        ],
        image: "https://images.pexels.com/photos/1667088/pexels-photo-1667088.jpeg?auto=compress&cs=tinysrgb&w=800",
    },
    {
        title: "Digital Experiences",
        description:
            "Immersive websites and applications that push boundaries and convert visitors into customers.",
        includes: [
            "Web design & development",
            "E-commerce platforms",
            "Web applications",
            "CMS integration",
            "Performance optimization",
        ],
        image: "https://images.pexels.com/photos/196644/pexels-photo-196644.jpeg?auto=compress&cs=tinysrgb&w=800",
    },
    {
        title: "Motion & Animation",
        description:
            "Bringing brands to life through elegant motion design that captures attention and tells stories.",
        includes: [
            "Explainer videos",
            "UI animations",
            "Logo animations",
            "Social media content",
            "Brand films",
        ],
        image: "https://images.pexels.com/photos/3184292/pexels-photo-3184292.jpeg?auto=compress&cs=tinysrgb&w=800",
    },
    {
        title: "Strategy & Consulting",
        description:
            "Strategic guidance to position your brand for success in the digital landscape.",
        includes: [
            "Brand strategy",
            "Digital transformation",
            "User research",
            "Growth consulting",
            "Competitive analysis",
        ],
        image: "https://images.pexels.com/photos/3184338/pexels-photo-3184338.jpeg?auto=compress&cs=tinysrgb&w=800",
    },
];

// Process steps
const processSteps = [
    {
        phase: "DISCOVER",
        duration: "1-2 weeks",
        description:
            "We immerse ourselves in your world. Through interviews, research, and analysis, we uncover insights that inform every decision.",
        deliverables: [
            "Stakeholder interviews",
            "Competitive analysis",
            "User research",
            "Project brief",
        ],
    },
    {
        phase: "DESIGN",
        duration: "2-4 weeks",
        description:
            "Ideas take shape. We explore concepts, iterate continuously, and refine until we arrive at a solution that exceeds expectations.",
        deliverables: [
            "Mood boards",
            "Wireframes",
            "Visual concepts",
            "Prototype",
        ],
    },
    {
        phase: "DEVELOP",
        duration: "4-8 weeks",
        description:
            "Designs become reality. Our development process ensures pixel-perfect execution with performance at the core.",
        deliverables: [
            "Frontend development",
            "CMS integration",
            "Testing & QA",
            "Performance optimization",
        ],
    },
    {
        phase: "DELIVER",
        duration: "Ongoing",
        description:
            "Launch is just the beginning. We provide training, documentation, and ongoing support to ensure lasting success.",
        deliverables: [
            "Deployment",
            "Documentation",
            "Training",
            "Ongoing support",
        ],
    },
];

// FAQs
const faqs = [
    {
        question: "How long does a typical project take?",
        answer: "Project timelines vary based on scope. A brand identity typically takes 6-8 weeks, while a complete website can range from 8-16 weeks. We'll provide a detailed timeline during our initial consultation.",
    },
    {
        question: "What is your design process?",
        answer: "Our process follows four phases: Discover, Design, Develop, and Deliver. This structured approach ensures we understand your needs deeply, explore solutions thoroughly, and execute flawlessly.",
    },
    {
        question: "Do you work with startups?",
        answer: "Absolutely. We love working with ambitious startups looking to establish a strong brand foundation. We offer flexible engagement models to accommodate various budgets and growth stages.",
    },
    {
        question: "What is your pricing model?",
        answer: "Every project is unique, so we provide custom quotes based on scope, complexity, and timeline. We offer project-based pricing for defined scopes and retainer arrangements for ongoing work.",
    },
    {
        question: "Do you offer ongoing support?",
        answer: "Yes, we offer maintenance and support packages to keep your digital presence running smoothly. This includes updates, security patches, content changes, and strategic guidance.",
    },
];
---

<Layout
    title="Services"
    description="End-to-end solutions for ambitious brands. Brand identity, digital experiences, motion design, and strategic consulting."
>
    <!-- Hero Section -->
    <section
        class="min-h-[60vh] flex items-end pb-20"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x); padding-top: 150px;"
    >
        <div class="w-full">
            <h1 class="text-hero font-display mb-6 fade-up">SERVICES</h1>
            <p
                class="text-body text-muted max-w-2xl fade-up"
                style="transition-delay: 0.1s;"
            >
                End-to-end solutions for ambitious brands. From strategy to
                execution, we craft experiences that elevate and transform.
            </p>
        </div>
    </section>

    <!-- Services Sections -->
    {
        services.map((service, index) => (
            <section
                class={`section border-t border-subtle ${index % 2 === 1 ? "bg-charcoal-light" : ""}`}
                style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
            >
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center max-w-6xl mx-auto">
                    <div class={`${index % 2 === 1 ? "lg:order-2" : ""}`}>
                        <h2 class="text-section-title font-display mb-6 fade-up">
                            {service.title}
                        </h2>
                        <p class="text-body text-muted mb-8 fade-up">
                            {service.description}
                        </p>
                        <div class="fade-up">
                            <h3 class="text-label mb-4">What's Included</h3>
                            <ul class="space-y-3">
                                {service.includes.map((item) => (
                                    <li class="flex items-center gap-3 text-body-sm">
                                        <span class="text-gold">→</span>
                                        {item}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                    <div
                        class={`${index % 2 === 1 ? "lg:order-1" : ""} fade-up`}
                        data-parallax="0.1"
                    >
                        <img
                            src={service.image}
                            alt={service.title}
                            class="w-full aspect-[4/3] object-cover"
                            loading="lazy"
                        />
                    </div>
                </div>
            </section>
        ))
    }

    <!-- Process Section -->
    <section
        class="section border-t border-subtle"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <h2 class="text-label mb-20">Our Process</h2>
        <div class="max-w-5xl mx-auto">
            {
                processSteps.map((step, index) => (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16 pb-16 border-b border-subtle last:border-b-0 fade-up">
                        <div class="md:col-span-3">
                            <span class="text-display text-gold opacity-20">
                                {String(index + 1).padStart(2, "0")}
                            </span>
                        </div>
                        <div class="md:col-span-9">
                            <div class="flex flex-wrap items-center gap-4 mb-4">
                                <h3 class="text-heading font-display">
                                    {step.phase}
                                </h3>
                                <span class="text-caption text-muted">
                                    {step.duration}
                                </span>
                            </div>
                            <p class="text-body text-muted mb-6">
                                {step.description}
                            </p>
                            <div class="flex flex-wrap gap-3">
                                {step.deliverables.map((item) => (
                                    <span class="text-caption px-4 py-2 border border-subtle">
                                        {item}
                                    </span>
                                ))}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- FAQ Section -->
    <section
        class="section border-t border-subtle"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <h2 class="text-label mb-20">Common Questions</h2>
        <div class="max-w-4xl mx-auto">
            {
                faqs.map((faq) => (
                    <div class="accordion-item">
                        <div class="accordion-header">
                            <h3 class="text-subheading font-display pr-8">
                                {faq.question}
                            </h3>
                            <span class="accordion-icon">+</span>
                        </div>
                        <div class="accordion-content">
                            <p class="text-body text-muted">{faq.answer}</p>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- CTA Section -->
    <section
        class="section border-t border-subtle text-center"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <h2 class="text-heading font-display mb-4 fade-up">Ready to start?</h2>
        <p class="text-body text-muted mb-8 fade-up">
            Every great project begins with a conversation.
        </p>
        <a href="/contact" class="btn btn-primary fade-up">Get in Touch</a>
    </section>
</Layout>

<style>
    .text-display {
        font-size: clamp(60px, 10vw, 120px);
        line-height: 0.8;
    }
</style>
