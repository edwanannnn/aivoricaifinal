---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Get featured projects
const allProjects = await getCollection("projects");
const featuredProjects = allProjects
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4);

// Testimonials data
const testimonials = [
	{
		quote: "AIVORIC transformed our brand into something truly exceptional. Their attention to detail exceeded all expectations.",
		author: "Sarah Chen",
		company: "Ethereal Fashion",
	},
	{
		quote: "Working with AIVORIC felt like having an extension of our team. They understood our vision and delivered beyond what we imagined.",
		author: "Marcus Williams",
		company: "Luxe Interiors",
	},
	{
		quote: "The level of craftsmanship in every pixel is remarkable. AIVORIC creates digital art.",
		author: "Elena Rodriguez",
		company: "Noir Architecture",
	},
];

// Stats data
const stats = [
	{ number: 50, suffix: "+", label: "Projects" },
	{ number: 98, suffix: "%", label: "Satisfaction" },
	{ number: 15, suffix: "+", label: "Awards" },
	{ number: 8, suffix: "+", label: "Years" },
];

// Process steps
const processSteps = [
	{ number: "01", title: "DISCOVER", description: "Research & Strategy" },
	{ number: "02", title: "DESIGN", description: "Concepts & Iterations" },
	{ number: "03", title: "DEVELOP", description: "Build & Optimize" },
	{ number: "04", title: "DELIVER", description: "Launch & Support" },
];

// Services data
const services = [
	{
		title: "Brand Identity",
		description:
			"Crafting distinctive visual identities that resonate with your audience and stand the test of time.",
	},
	{
		title: "Digital Experiences",
		description:
			"Immersive websites and applications that push boundaries and convert visitors into customers.",
	},
	{
		title: "Motion & Animation",
		description:
			"Bringing brands to life through elegant motion design that captures attention.",
	},
	{
		title: "Strategy & Consulting",
		description:
			"Strategic guidance to position your brand for success in the digital landscape.",
	},
];

// Sample projects for display
const sampleProjects = [
	{
		title: "Ethereal Brand",
		year: 2024,
		category: "branding",
		image: "https://images.pexels.com/photos/6476589/pexels-photo-6476589.jpeg?auto=compress&cs=tinysrgb&w=800",
		slug: "ethereal-brand",
	},
	{
		title: "Luxe Digital",
		year: 2024,
		category: "digital",
		image: "https://images.pexels.com/photos/3184287/pexels-photo-3184287.jpeg?auto=compress&cs=tinysrgb&w=800",
		slug: "luxe-digital",
	},
	{
		title: "Noir Studio",
		year: 2023,
		category: "digital",
		image: "https://images.pexels.com/photos/6077326/pexels-photo-6077326.jpeg?auto=compress&cs=tinysrgb&w=800",
		slug: "noir-studio",
	},
	{
		title: "Avant Garde",
		year: 2023,
		category: "branding",
		image: "https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg?auto=compress&cs=tinysrgb&w=800",
		slug: "avant-garde",
	},
];

const projects =
	featuredProjects.length > 0
		? featuredProjects.map((p) => ({
				title: p.data.title,
				year: p.data.year,
				category: p.data.category,
				image: p.data.heroImage,
				slug: p.slug,
			}))
		: sampleProjects;
---

<Layout
	title="AIVORIC"
	description="A luxury digital agency crafting award-winning brand experiences, websites, and digital products."
>
	<!-- Hero Section -->
	<section
		class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16"
	>
		<!-- Background Video - Desktop only / Static image on mobile -->
		<div class="absolute inset-0 flex items-center justify-center">
			<div
				class="video-container w-[85vw] md:w-[70vw] lg:w-[60vw] h-[40vh] md:h-[50vh] relative"
			>
				<!-- Mobile: Static image for performance -->
				<img
					src="https://images.pexels.com/photos/3184291/pexels-photo-3184291.jpeg?auto=compress&cs=tinysrgb&w=800"
					alt="Digital artistry"
					class="video-poster block lg:hidden"
					loading="eager"
					fetchpriority="high"
				/>
				<!-- Desktop: Vimeo video -->
				<iframe
					src="https://player.vimeo.com/video/358909053?background=1&autoplay=1&loop=1&muted=1"
					class="video-iframe hidden lg:block"
					allow="autoplay; fullscreen"
					loading="lazy"
					title="Background video"></iframe>
			</div>
		</div>

		<!-- Hero Text -->
		<div class="relative z-10 w-full px-4 md:px-8 lg:px-16">
			<h1
				class="text-display font-display text-center lg:text-left"
				data-hero
			>
				REDEFINING
			</h1>
			<h1
				class="text-display font-display text-center lg:text-right"
				data-hero
			>
				DIGITAL
			</h1>
		</div>

		<!-- Scroll Indicator -->
		<div class="scroll-indicator">
			<span>Scroll</span>
			<div class="scroll-indicator-arrow"></div>
		</div>
	</section>

	<!-- Marquee Section -->
	<div class="py-8 md:py-12 border-t border-b border-subtle">
		<div class="marquee">
			<div class="marquee-content">
				<span class="marquee-text">DIGITAL</span>
				<span class="marquee-text">•</span>
				<span class="marquee-text">ARTISTRY</span>
				<span class="marquee-text">•</span>
				<span class="marquee-text">FUTURE</span>
				<span class="marquee-text">•</span>
			</div>
			<div class="marquee-content" aria-hidden="true">
				<span class="marquee-text">DIGITAL</span>
				<span class="marquee-text">•</span>
				<span class="marquee-text">ARTISTRY</span>
				<span class="marquee-text">•</span>
				<span class="marquee-text">FUTURE</span>
				<span class="marquee-text">•</span>
			</div>
		</div>
	</div>

	<!-- Selected Works Section -->
	<section class="section">
		<h2 class="text-label mb-12 md:mb-20">Selected Works</h2>

		<!-- Mobile: Single column -->
		<div class="grid grid-cols-1 gap-8 lg:hidden">
			{
				projects.slice(0, 4).map((project, index) => (
					<a
						href={`/work/${project.slug}`}
						class="project-card fade-up"
						data-project
						style={`transition-delay: ${index * 0.1}s;`}
					>
						<div class="project-card-image aspect-[4/3] mb-3">
							<img
								src={project.image}
								alt={project.title}
								loading={index < 2 ? "eager" : "lazy"}
								decoding="async"
							/>
						</div>
						<div class="flex justify-between items-end">
							<h3 class="text-subheading font-display">
								{project.title}
							</h3>
							<span class="text-label">{project.year}</span>
						</div>
					</a>
				))
			}
		</div>

		<!-- Desktop: Asymmetrical grid -->
		<div class="hidden lg:grid grid-cols-12 gap-8">
			{
				projects.slice(0, 4).map((project, index) => (
					<a
						href={`/work/${project.slug}`}
						class={`project-card ${index % 2 === 0 ? "col-span-7" : "col-span-5"} ${index === 1 || index === 3 ? "mt-24" : ""}`}
						data-project
					>
						<div
							class={`project-card-image ${index % 2 === 0 ? "aspect-[4/3]" : "aspect-[3/4]"} mb-4 overflow-hidden`}
						>
							<img
								src={project.image}
								alt={project.title}
								loading="lazy"
								decoding="async"
							/>
							<div class="project-card-overlay">
								<span class="text-subheading font-display">
									{project.title}
								</span>
							</div>
						</div>
						<div class="flex justify-between items-end">
							<h3 class="text-subheading font-display">
								{project.title}
							</h3>
							<span class="text-label">{project.year}</span>
						</div>
					</a>
				))
			}
		</div>

		<!-- View All Work Button -->
		<div class="flex justify-center mt-12 md:mt-20">
			<a href="/work" class="btn fade-up">View All Work</a>
		</div>
	</section>

	<!-- Philosophy Section -->
	<section class="section border-t border-subtle">
		<h2 class="text-label mb-12 md:mb-20">Philosophy</h2>
		<div class="max-w-5xl mx-auto">
			<p class="text-heading font-display leading-snug fade-up">
				<span class="reveal-line block text-muted"
					>We believe digital experiences should transcend</span
				>
				<span class="reveal-line block text-muted"
					>the ordinary. Each project is a marriage of art</span
				>
				<span class="reveal-line block text-muted"
					>and technology, crafted with meticulous attention</span
				>
				<span class="reveal-line block text-muted"
					>to detail and an unwavering commitment to excellence.</span
				>
			</p>
		</div>
	</section>

	<!-- Services Accordion Section -->
	<section class="section border-t border-subtle">
		<h2 class="text-label mb-12 md:mb-20">What We Do</h2>
		<div class="max-w-4xl mx-auto">
			{
				services.map((service, index) => (
					<div
						class="accordion-item fade-up"
						style={`transition-delay: ${index * 0.1}s;`}
					>
						<div class="accordion-header">
							<h3 class="text-subheading font-display pr-4">
								{service.title}
							</h3>
							<span class="accordion-icon">+</span>
						</div>
						<div class="accordion-content">
							<p class="text-body text-muted max-w-2xl">
								{service.description}
							</p>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<!-- Stats Section -->
	<section class="section border-t border-subtle">
		<h2 class="text-label mb-12 md:mb-20">By The Numbers</h2>
		<div
			class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-12 max-w-4xl mx-auto"
		>
			{
				stats.map((stat, index) => (
					<div
						class="text-center fade-up"
						style={`transition-delay: ${index * 0.1}s;`}
					>
						<div
							class="stat-number"
							data-counter={stat.number}
							data-suffix={stat.suffix}
						>
							{stat.number}
							{stat.suffix}
						</div>
						<div class="stat-label">{stat.label}</div>
					</div>
				))
			}
		</div>
	</section>

	<!-- Testimonials Section -->
	<section class="section border-t border-subtle">
		<h2 class="text-label mb-12 md:mb-20">Client Love</h2>
		<div
			class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 max-w-5xl mx-auto"
		>
			{
				testimonials.map((testimonial, index) => (
					<div
						class="card fade-up"
						style={`transition-delay: ${index * 0.1}s;`}
					>
						<p class="testimonial-quote">"{testimonial.quote}"</p>
						<p class="testimonial-author">{testimonial.author}</p>
						<p class="text-label mt-1">{testimonial.company}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- Process Section -->
	<section class="section border-t border-subtle">
		<h2 class="text-label mb-12 md:mb-20">Our Process</h2>
		<div
			class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 max-w-5xl mx-auto"
		>
			{
				processSteps.map((step, index) => (
					<div
						class="process-step fade-up"
						style={`transition-delay: ${index * 0.1}s;`}
					>
						<span class="process-number">{step.number}</span>
						<h3 class="text-body font-display mb-1 relative z-10">
							{step.title}
						</h3>
						<p class="text-body-sm text-muted relative z-10">
							{step.description}
						</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- CTA Section -->
	<section class="section border-t border-subtle text-center">
		<h2 class="text-heading font-display mb-4 md:mb-8 fade-up">
			LET'S CREATE SOMETHING<br class="hidden md:block" /> EXTRAORDINARY
		</h2>
		<a href="/contact" class="btn btn-primary fade-up">Start Your Project</a
		>
	</section>
</Layout>
