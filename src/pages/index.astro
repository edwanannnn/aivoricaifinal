---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Get featured projects
const allProjects = await getCollection("projects");
const featuredProjects = allProjects
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4);

// Get featured blog posts for potential use
const allPosts = await getCollection("blog");
const featuredPosts = allPosts
	.filter((p) => p.data.featured)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

// Testimonials data
const testimonials = [
	{
		quote: "AIVORIC transformed our brand into something truly exceptional. Their attention to detail and creative vision exceeded all expectations.",
		author: "Sarah Chen",
		company: "Ethereal Fashion",
		logo: "/images/logos/ethereal.svg",
	},
	{
		quote: "Working with AIVORIC felt like having an extension of our team. They understood our vision and delivered beyond what we imagined.",
		author: "Marcus Williams",
		company: "Luxe Interiors",
		logo: "/images/logos/luxe.svg",
	},
	{
		quote: "The level of craftsmanship in every pixel is remarkable. AIVORIC doesn't just build websites, they create digital art.",
		author: "Elena Rodriguez",
		company: "Noir Architecture",
		logo: "/images/logos/noir.svg",
	},
];

// Stats data
const stats = [
	{ number: 50, suffix: "+", label: "Projects Delivered" },
	{ number: 98, suffix: "%", label: "Client Satisfaction" },
	{ number: 15, suffix: "+", label: "Awards Won" },
	{ number: 8, suffix: "+", label: "Years Experience" },
];

// Process steps
const processSteps = [
	{ number: "01", title: "DISCOVER", description: "Research & Strategy" },
	{ number: "02", title: "DESIGN", description: "Concepts & Iterations" },
	{ number: "03", title: "DEVELOP", description: "Build & Optimize" },
	{ number: "04", title: "DELIVER", description: "Launch & Support" },
];

// Services data
const services = [
	{
		title: "Brand Identity",
		description:
			"Crafting distinctive visual identities that resonate with your audience. From logo design to comprehensive brand guidelines, we build brands that stand the test of time.",
		image: "https://images.pexels.com/photos/1667088/pexels-photo-1667088.jpeg?auto=compress&cs=tinysrgb&w=600",
	},
	{
		title: "Digital Experiences",
		description:
			"Immersive websites and applications that push boundaries. We combine cutting-edge technology with thoughtful design to create experiences that captivate and convert.",
		image: "https://images.pexels.com/photos/196644/pexels-photo-196644.jpeg?auto=compress&cs=tinysrgb&w=600",
	},
	{
		title: "Motion & Animation",
		description:
			"Bringing your brand to life through elegant motion design. From micro-interactions to full-scale animations, we add that extra layer of sophistication.",
		image: "https://images.pexels.com/photos/3184292/pexels-photo-3184292.jpeg?auto=compress&cs=tinysrgb&w=600",
	},
	{
		title: "Strategy & Consulting",
		description:
			"Strategic guidance to position your brand for success. We analyze, ideate, and execute strategies that deliver measurable results and sustainable growth.",
		image: "https://images.pexels.com/photos/3184338/pexels-photo-3184338.jpeg?auto=compress&cs=tinysrgb&w=600",
	},
];

// Sample projects for display (fallback if no content collection)
const sampleProjects = [
	{
		title: "Ethereal Brand",
		year: 2024,
		category: "branding",
		image: "https://images.pexels.com/photos/6476589/pexels-photo-6476589.jpeg?auto=compress&cs=tinysrgb&w=1200",
		slug: "ethereal-brand",
	},
	{
		title: "Luxe Digital",
		year: 2024,
		category: "digital",
		image: "https://images.pexels.com/photos/3184287/pexels-photo-3184287.jpeg?auto=compress&cs=tinysrgb&w=800",
		slug: "luxe-digital",
	},
	{
		title: "Noir Studio",
		year: 2023,
		category: "digital",
		image: "https://images.pexels.com/photos/6077326/pexels-photo-6077326.jpeg?auto=compress&cs=tinysrgb&w=800",
		slug: "noir-studio",
	},
	{
		title: "Avant Garde",
		year: 2023,
		category: "branding",
		image: "https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg?auto=compress&cs=tinysrgb&w=1200",
		slug: "avant-garde",
	},
];

const projects =
	featuredProjects.length > 0
		? featuredProjects.map((p) => ({
				title: p.data.title,
				year: p.data.year,
				category: p.data.category,
				image: p.data.heroImage,
				slug: p.slug,
			}))
		: sampleProjects;
---

<Layout
	title="AIVORIC"
	description="A luxury digital agency crafting award-winning brand experiences, websites, and digital products that redefine excellence."
>
	<!-- Hero Section -->
	<section
		class="relative h-screen flex items-center justify-center overflow-hidden"
	>
		<!-- Background Video -->
		<div class="absolute inset-0 flex items-center justify-center">
			<div class="video-mask w-[60vw] h-[50vh] relative overflow-hidden">
				<iframe
					src="https://player.vimeo.com/video/358909053?background=1&autoplay=1&loop=1&byline=0&title=0&muted=1"
					style="position:absolute;top:50%;left:50%;width:120%;height:120%;transform:translate(-50%,-50%);opacity:0.3;"
					frameborder="0"
					allow="autoplay; fullscreen; picture-in-picture"
					loading="lazy"
				>
				</iframe>
			</div>
		</div>

		<!-- Hero Text -->
		<div class="relative z-10 w-full px-8 md:px-16">
			<h1 class="text-display font-display text-left opacity-0" data-hero>
				REDEFINING
			</h1>
			<h1
				class="text-display font-display text-right opacity-0"
				data-hero
			>
				DIGITAL
			</h1>
		</div>

		<!-- Scroll Indicator -->
		<div class="scroll-indicator">
			<span>Scroll</span>
			<div class="scroll-indicator-arrow"></div>
		</div>
	</section>

	<!-- Marquee Section -->
	<div class="py-12 border-t border-b border-subtle">
		<div class="marquee">
			<div class="marquee-content">
				<span class="text-6xl font-display text-muted">DIGITAL</span>
				<span class="text-6xl font-display text-muted">•</span>
				<span class="text-6xl font-display text-muted">ARTISTRY</span>
				<span class="text-6xl font-display text-muted">•</span>
				<span class="text-6xl font-display text-muted">FUTURE</span>
				<span class="text-6xl font-display text-muted">•</span>
			</div>
			<div class="marquee-content" aria-hidden="true">
				<span class="text-6xl font-display text-muted">DIGITAL</span>
				<span class="text-6xl font-display text-muted">•</span>
				<span class="text-6xl font-display text-muted">ARTISTRY</span>
				<span class="text-6xl font-display text-muted">•</span>
				<span class="text-6xl font-display text-muted">FUTURE</span>
				<span class="text-6xl font-display text-muted">•</span>
			</div>
		</div>
	</div>

	<!-- Selected Works Section -->
	<section
		class="section"
		style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
	>
		<h2 class="text-label mb-20">Selected Works</h2>
		<div class="grid grid-cols-1 md:grid-cols-12 gap-8">
			{
				projects.slice(0, 4).map((project, index) => (
					<a
						href={`/work/${project.slug}`}
						class={`project-card ${index % 2 === 0 ? "md:col-span-7" : "md:col-span-5"} ${index === 1 || index === 3 ? "md:mt-32" : ""}`}
						data-project
					>
						<div
							class={`project-card-image ${index % 2 === 0 ? "aspect-[4/3]" : "aspect-[3/4]"} bg-charcoal-light mb-4 overflow-hidden`}
						>
							<img
								src={project.image}
								alt={project.title}
								class="w-full h-full object-cover"
								loading="lazy"
							/>
							<div class="project-card-overlay">
								<span class="text-subheading font-display">
									{project.title}
								</span>
							</div>
						</div>
						<div class="flex justify-between items-end">
							<h3 class="text-2xl font-display">
								{project.title}
							</h3>
							<span class="text-caption">{project.year}</span>
						</div>
					</a>
				))
			}
		</div>

		<!-- View All Work Button -->
		<div class="flex justify-center mt-20">
			<a href="/work" class="btn">View All Work</a>
		</div>
	</section>

	<!-- Philosophy Section -->
	<section
		class="section border-t border-subtle"
		style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
	>
		<h2 class="text-label mb-20">Philosophy</h2>
		<div class="max-w-5xl mx-auto">
			<p
				class="text-section-title font-display leading-tight"
				data-reveal
			>
				<span class="reveal-line"
					>We believe digital experiences should transcend</span
				>
				<span class="reveal-line"
					>the ordinary. Each project is a marriage of art</span
				>
				<span class="reveal-line"
					>and technology, crafted with meticulous attention</span
				>
				<span class="reveal-line"
					>to detail and an unwavering commitment to excellence.</span
				>
			</p>
		</div>
	</section>

	<!-- Services Accordion Section -->
	<section
		class="section border-t border-subtle"
		style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
	>
		<h2 class="text-label mb-20">What We Do</h2>
		<div class="max-w-6xl mx-auto">
			{
				services.map((service) => (
					<div class="accordion-item" data-img={service.image}>
						<div class="accordion-header">
							<h3 class="text-heading font-display">
								{service.title}
							</h3>
							<span class="accordion-icon">+</span>
						</div>
						<div class="accordion-content">
							<p class="text-body text-muted max-w-2xl">
								{service.description}
							</p>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<!-- Stats Section -->
	<section
		class="section border-t border-subtle"
		style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
	>
		<h2 class="text-label mb-20">By The Numbers</h2>
		<div
			class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-16 max-w-6xl mx-auto"
		>
			{
				stats.map((stat) => (
					<div class="text-center fade-up">
						<div
							class="stat-number"
							data-counter={stat.number}
							data-suffix={stat.suffix}
						>
							0
						</div>
						<div class="stat-label">{stat.label}</div>
					</div>
				))
			}
		</div>
	</section>

	<!-- Testimonials Section -->
	<section
		class="section border-t border-subtle"
		style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
	>
		<h2 class="text-label mb-20">Client Love</h2>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
			{
				testimonials.map((testimonial, index) => (
					<div
						class="card fade-up"
						style={`transition-delay: ${index * 0.1}s`}
					>
						<p class="testimonial-quote">"{testimonial.quote}"</p>
						<p class="testimonial-author">{testimonial.author}</p>
						<p class="text-caption mt-1">{testimonial.company}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- Process Section -->
	<section
		class="section border-t border-subtle"
		style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
	>
		<h2 class="text-label mb-20">Our Process</h2>
		<div class="grid grid-cols-1 md:grid-cols-4 gap-8 max-w-6xl mx-auto">
			{
				processSteps.map((step, index) => (
					<div
						class="process-step fade-up"
						style={`transition-delay: ${index * 0.15}s`}
					>
						<span class="process-number">{step.number}</span>
						<h3 class="text-subheading font-display mb-2 relative z-10">
							{step.title}
						</h3>
						<p class="text-body-sm text-muted relative z-10">
							{step.description}
						</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- CTA Section -->
	<section
		class="section border-t border-subtle text-center"
		style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
	>
		<h2 class="text-section-title font-display mb-8 fade-up">
			LET'S CREATE SOMETHING<br />EXTRAORDINARY
		</h2>
		<a href="/contact" class="btn btn-primary fade-up">Start Your Project</a
		>
	</section>
</Layout>

<style>
	/* Page-specific styles */
	.text-display {
		font-size: clamp(60px, 12vw, 180px);
	}

	.stat-number {
		color: var(--color-gold);
	}

	.process-step {
		position: relative;
		padding-left: 0;
		padding-top: 80px;
	}

	.process-number {
		position: absolute;
		left: 0;
		top: 0;
		font-family: var(--font-display);
		font-size: 100px;
		font-weight: 700;
		color: var(--color-gold);
		opacity: 0.1;
		line-height: 1;
	}

	@media (max-width: 768px) {
		.process-number {
			font-size: 60px;
		}
		.process-step {
			padding-top: 50px;
		}
	}
</style>
