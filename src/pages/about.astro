---
import Layout from "../layouts/Layout.astro";

// Team members
const team = [
    {
        name: "Alexander Chen",
        role: "Founder & Creative Director",
        bio: "Former lead designer at Google, Alexander brings 15 years of experience crafting digital experiences for global brands.",
        image: "https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=600",
    },
    {
        name: "Sarah Williams",
        role: "Design Director",
        bio: "Award-winning designer specializing in luxury branding and visual identities that stand the test of time.",
        image: "https://images.pexels.com/photos/3756679/pexels-photo-3756679.jpeg?auto=compress&cs=tinysrgb&w=600",
    },
    {
        name: "Marcus Thompson",
        role: "Technical Director",
        bio: "Full-stack architect with a passion for performance optimization and cutting-edge web technologies.",
        image: "https://images.pexels.com/photos/2182970/pexels-photo-2182970.jpeg?auto=compress&cs=tinysrgb&w=600",
    },
    {
        name: "Elena Rodriguez",
        role: "Strategy Lead",
        bio: "Brand strategist helping companies define their positioning and connect authentically with audiences.",
        image: "https://images.pexels.com/photos/3769021/pexels-photo-3769021.jpeg?auto=compress&cs=tinysrgb&w=600",
    },
    {
        name: "James Park",
        role: "Motion Designer",
        bio: "Specializing in UI animations and brand films that bring static designs to life.",
        image: "https://images.pexels.com/photos/1222271/pexels-photo-1222271.jpeg?auto=compress&cs=tinysrgb&w=600",
    },
    {
        name: "Olivia Foster",
        role: "Project Manager",
        bio: "Keeping our projects on track and our clients happy with clear communication and flawless execution.",
        image: "https://images.pexels.com/photos/3785079/pexels-photo-3785079.jpeg?auto=compress&cs=tinysrgb&w=600",
    },
];

// Values
const values = [
    {
        title: "Excellence",
        description:
            "We don't cut corners. Every pixel, every line of code, every interaction is crafted with intention.",
    },
    {
        title: "Innovation",
        description:
            "We push boundaries and embrace new technologies to create experiences that feel ahead of their time.",
    },
    {
        title: "Partnership",
        description:
            "Your success is our success. We work alongside you as an extension of your team.",
    },
];

// Awards (placeholder logos)
const awards = [
    "Awwwards",
    "FWA",
    "CSS Design Awards",
    "Webby Awards",
    "Red Dot Design",
];

// Clients (placeholder)
const clients = [
    "Ethereal Fashion",
    "Luxe Interiors",
    "Noir Architecture",
    "Zenith Corp",
    "Velocity Sports",
    "Avant Garde Gallery",
];
---

<Layout
    title="About"
    description="We are AIVORIC, a studio obsessed with craft. Founded in 2016, we create digital experiences that transcend the ordinary."
>
    <!-- Hero Section -->
    <section
        class="min-h-[60vh] flex items-end pb-20"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x); padding-top: 150px;"
    >
        <div class="w-full">
            <h1 class="text-hero font-display mb-6 fade-up">WE ARE AIVORIC</h1>
            <p
                class="text-subheading font-display text-muted max-w-3xl fade-up"
                style="transition-delay: 0.1s;"
            >
                A studio obsessed with craft
            </p>
        </div>
    </section>

    <!-- Story Section -->
    <section
        class="section border-t border-subtle"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <div class="max-w-5xl mx-auto">
            <p
                class="text-section-title font-display leading-tight fade-up"
                data-reveal
            >
                <span class="reveal-line"
                    >Founded in 2016, AIVORIC emerged from a simple</span
                >
                <span class="reveal-line"
                    >belief: digital experiences should be beautiful,</span
                >
                <span class="reveal-line"
                    >functional, and unforgettable. We're a collective of</span
                >
                <span class="reveal-line"
                    >designers, developers, and strategists who treat</span
                >
                <span class="reveal-line"
                    >every project as our masterpiece.</span
                >
            </p>
        </div>
    </section>

    <!-- Values Section -->
    <section
        class="section border-t border-subtle"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <h2 class="text-label mb-20">Our Values</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {
                values.map((value, index) => (
                    <div
                        class="card fade-up"
                        style={`transition-delay: ${index * 0.1}s;`}
                    >
                        <h3 class="text-heading font-display mb-4 text-gold">
                            {value.title}
                        </h3>
                        <p class="text-body text-muted">{value.description}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Team Section -->
    <section
        class="section border-t border-subtle"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <h2 class="text-label mb-20">The Team</h2>
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto"
        >
            {
                team.map((member, index) => (
                    <div
                        class="team-card fade-up"
                        style={`transition-delay: ${index * 0.1}s;`}
                    >
                        <div class="team-card-image">
                            <img
                                src={member.image}
                                alt={member.name}
                                loading="lazy"
                            />
                            <div class="team-card-overlay">
                                <p class="team-card-bio">{member.bio}</p>
                            </div>
                        </div>
                        <h3 class="text-xl font-display mb-1">{member.name}</h3>
                        <p class="text-caption text-muted">{member.role}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Awards Section -->
    <section
        class="section border-t border-subtle"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <h2 class="text-label mb-20">Recognition</h2>
        <div class="flex flex-wrap justify-center gap-12 max-w-4xl mx-auto">
            {
                awards.map((award, index) => (
                    <div
                        class="text-center fade-up opacity-50 hover:opacity-100 transition-opacity"
                        style={`transition-delay: ${index * 0.1}s;`}
                    >
                        <span class="text-xl font-display">{award}</span>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Clients Section -->
    <section
        class="section border-t border-subtle"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <h2 class="text-label mb-20">Clients We've Worked With</h2>
        <div
            class="flex flex-wrap justify-center gap-8 md:gap-16 max-w-5xl mx-auto"
        >
            {
                clients.map((client, index) => (
                    <div
                        class="text-center fade-up opacity-40 hover:opacity-100 transition-opacity"
                        style={`transition-delay: ${index * 0.1}s;`}
                    >
                        <span class="text-lg font-display">{client}</span>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- CTA Section -->
    <section
        class="section border-t border-subtle text-center"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <h2 class="text-heading font-display mb-4 fade-up">
            Want to work with us?
        </h2>
        <p class="text-body text-muted mb-8 fade-up">
            We're always looking for ambitious projects and talented people.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="btn btn-primary fade-up"
                >Start a Project</a
            >
            <a href="/work" class="btn fade-up">View Our Work</a>
        </div>
    </section>
</Layout>
