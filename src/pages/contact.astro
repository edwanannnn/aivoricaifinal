---
import Layout from "../layouts/Layout.astro";

// Contact form fields
const projectTypes = [
    "Branding",
    "Website",
    "E-commerce",
    "Motion",
    "Strategy",
    "Other",
];
const budgetRanges = [
    "Less than $10k",
    "$10k - $25k",
    "$25k - $50k",
    "$50k - $100k",
    "$100k+",
    "Not sure yet",
];
---

<Layout
    title="Contact"
    description="Tell us about your project. Let's create something extraordinary together."
>
    <!-- Hero Section -->
    <section
        class="min-h-[40vh] flex items-end pb-20"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x); padding-top: 150px;"
    >
        <div class="w-full">
            <h1 class="text-hero font-display mb-6 fade-up">LET'S TALK</h1>
            <p
                class="text-body text-muted max-w-2xl fade-up"
                style="transition-delay: 0.1s;"
            >
                Have a project in mind? We'd love to hear about it. Fill out the
                form below or reach out directly.
            </p>
        </div>
    </section>

    <!-- Contact Form Section -->
    <section
        class="section border-t border-subtle"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 max-w-6xl mx-auto">
            <!-- Form -->
            <div class="lg:col-span-8">
                <form
                    id="contact-form"
                    action="https://api.web3forms.com/submit"
                    method="POST"
                    class="space-y-8"
                >
                    <!-- Web3Forms Access Key - Replace with your own -->
                    <input
                        type="hidden"
                        name="access_key"
                        value="YOUR_WEB3FORMS_KEY"
                    />
                    <input
                        type="hidden"
                        name="subject"
                        value="New Project Inquiry - AIVORIC"
                    />
                    <input
                        type="hidden"
                        name="from_name"
                        value="AIVORIC Website"
                    />

                    <!-- Honeypot for spam protection -->
                    <input
                        type="checkbox"
                        name="botcheck"
                        class="hidden"
                        style="display: none;"
                    />

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- Name -->
                        <div class="fade-up">
                            <label for="name" class="form-label">Name *</label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                class="form-input"
                                placeholder="Your name"
                            />
                        </div>

                        <!-- Email -->
                        <div class="fade-up" style="transition-delay: 0.1s;">
                            <label for="email" class="form-label">Email *</label
                            >
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                class="form-input"
                                placeholder="your@email.com"
                            />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- Company -->
                        <div class="fade-up">
                            <label for="company" class="form-label"
                                >Company</label
                            >
                            <input
                                type="text"
                                id="company"
                                name="company"
                                class="form-input"
                                placeholder="Your company name"
                            />
                        </div>

                        <!-- Project Type -->
                        <div class="fade-up" style="transition-delay: 0.1s;">
                            <label for="project-type" class="form-label"
                                >Project Type</label
                            >
                            <select
                                id="project-type"
                                name="project_type"
                                class="form-input form-select"
                            >
                                <option value="">Select a project type</option>
                                {
                                    projectTypes.map((type) => (
                                        <option value={type}>{type}</option>
                                    ))
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Budget -->
                    <div class="fade-up">
                        <label for="budget" class="form-label"
                            >Budget Range</label
                        >
                        <select
                            id="budget"
                            name="budget"
                            class="form-input form-select"
                        >
                            <option value="">Select a budget range</option>
                            {
                                budgetRanges.map((range) => (
                                    <option value={range}>{range}</option>
                                ))
                            }
                        </select>
                    </div>

                    <!-- Message -->
                    <div class="fade-up">
                        <label for="message" class="form-label"
                            >Tell us about your project *</label
                        >
                        <textarea
                            id="message"
                            name="message"
                            required
                            class="form-input form-textarea"
                            placeholder="What are you looking to achieve? Any specific goals, timeline, or inspirations?"
                            rows="6"></textarea>
                    </div>

                    <!-- Submit Button -->
                    <div class="fade-up">
                        <button
                            type="submit"
                            class="btn btn-primary w-full md:w-auto"
                        >
                            <span class="btn-text">Send Message</span>
                            <span class="btn-loading hidden">Sending...</span>
                        </button>
                    </div>

                    <!-- Success/Error Messages -->
                    <div
                        id="form-success"
                        class="hidden p-6 border border-gold text-center fade-up"
                    >
                        <p class="text-body text-gold">
                            Thank you! We'll be in touch within 24 hours.
                        </p>
                    </div>
                    <div
                        id="form-error"
                        class="hidden p-6 border border-red-500 text-center fade-up"
                    >
                        <p class="text-body text-red-400">
                            Something went wrong. Please try again or email us
                            directly.
                        </p>
                    </div>
                </form>
            </div>

            <!-- Contact Info Sidebar -->
            <aside class="lg:col-span-4">
                <div class="lg:sticky lg:top-32 space-y-12">
                    <!-- Email -->
                    <div class="fade-up">
                        <h3 class="text-label mb-4">Email</h3>
                        <a
                            href="mailto:hello@aivoric.studio"
                            class="text-body hover:text-gold transition-colors"
                        >
                            hello@aivoric.studio
                        </a>
                    </div>

                    <!-- Phone -->
                    <div class="fade-up">
                        <h3 class="text-label mb-4">Phone</h3>
                        <a
                            href="tel:+15551234567"
                            class="text-body hover:text-gold transition-colors"
                        >
                            +1 (555) 123-4567
                        </a>
                    </div>

                    <!-- Locations -->
                    <div class="fade-up">
                        <h3 class="text-label mb-4">Offices</h3>
                        <div class="space-y-2">
                            <p class="text-body">New York, NY</p>
                            <p class="text-body">Los Angeles, CA</p>
                        </div>
                    </div>

                    <!-- Hours -->
                    <div class="fade-up">
                        <h3 class="text-label mb-4">Business Hours</h3>
                        <p class="text-body text-muted">Monday - Friday</p>
                        <p class="text-body">9:00 AM - 6:00 PM EST</p>
                    </div>

                    <!-- Social Links -->
                    <div class="fade-up">
                        <h3 class="text-label mb-4">Follow Us</h3>
                        <div class="flex gap-6">
                            <a
                                href="https://instagram.com"
                                target="_blank"
                                rel="noopener"
                                class="text-body hover:text-gold transition-colors"
                                >Instagram</a
                            >
                            <a
                                href="https://linkedin.com"
                                target="_blank"
                                rel="noopener"
                                class="text-body hover:text-gold transition-colors"
                                >LinkedIn</a
                            >
                            <a
                                href="https://dribbble.com"
                                target="_blank"
                                rel="noopener"
                                class="text-body hover:text-gold transition-colors"
                                >Dribbble</a
                            >
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    <!-- Alternative CTA -->
    <section
        class="section border-t border-subtle text-center"
        style="padding-left: var(--section-padding-x); padding-right: var(--section-padding-x);"
    >
        <p class="text-body text-muted fade-up">
            Prefer email? Reach us directly at
            <a
                href="mailto:hello@aivoric.studio"
                class="text-gold hover:underline">hello@aivoric.studio</a
            >
        </p>
    </section>
</Layout>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const successMessage = document.getElementById("form-success");
    const errorMessage = document.getElementById("form-error");
    const submitBtn = form?.querySelector('button[type="submit"]');
    const btnText = submitBtn?.querySelector(".btn-text");
    const btnLoading = submitBtn?.querySelector(".btn-loading");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Show loading state
        if (btnText) btnText.classList.add("hidden");
        if (btnLoading) btnLoading.classList.remove("hidden");
        if (submitBtn) (submitBtn as HTMLButtonElement).disabled = true;

        try {
            const formData = new FormData(form);
            const response = await fetch(form.action, {
                method: "POST",
                body: formData,
                headers: {
                    Accept: "application/json",
                },
            });

            if (response.ok) {
                form.reset();
                successMessage?.classList.remove("hidden");
                errorMessage?.classList.add("hidden");
            } else {
                throw new Error("Form submission failed");
            }
        } catch (error) {
            errorMessage?.classList.remove("hidden");
            successMessage?.classList.add("hidden");
        } finally {
            // Reset button state
            if (btnText) btnText.classList.remove("hidden");
            if (btnLoading) btnLoading.classList.add("hidden");
            if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;
        }
    });
</script>

<style>
    .form-input:focus {
        outline: none;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>
